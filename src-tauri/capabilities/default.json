{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Antigravity Dual-Engine App",
  "local": true,
  "windows": ["*"],
  "remote": {
    "urls": [
      "https://antigravity.google.com/*",
      "https://gemini.google.com/*",
      "https://*.google.com/*",
      "https://antigravity.static.usercontent.goog/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "allow-app-commands"
  ]
}
