PORT=8787
DATABASE_PATH=./data/sync.db
JWT_SECRET=replace-with-a-random-32-byte-secret
VAULT_MASTER_KEY=replace-with-a-random-32-byte-master-key
# Google OAuth Web Client credentials (register <PUBLIC_BASE_URL>/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://sync.antigravity.app
# Set to true only for local LAN/dev testing without Google OAuth client setup
ALLOW_DEV_SSO=false
